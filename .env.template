# Copy to `.env` (gitignored). Read by cc_server from its WORKING DIRECTORY,
# under the real environment — an exported variable always wins, and a packaged
# or containerised server should export rather than rely on a CWD.

# Provider GIF
KLIPY_APP_KEY=

# Provider calendar — Google device-code client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Provider forges — the GitHub App: id + secret + key = the server's own identity,
# client id = what people sign in through (device flow needs no secret, and an
# official build already ships one, so this is for your own app).
# Put the PEM on one line: "-----BEGIN…-----\nMIIEow…\n-----END…-----"
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Provider forges — server-side tokens, for work with no human behind it
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_API_TOKEN=
BITBUCKET_EMAIL=

# Provider tickets — Linear signs in by browser redirect, so it needs a secret
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_API_KEY=

# Provider tickets — no sign-in wired; server-side only
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
CLICKUP_API_TOKEN=

# ---------------------------------------------------------------------------
# Server runtime — NOT credentials. Read before any database or settings screen
# exists (a server has to boot before you can configure it), so these have no
# Settings equivalent and each also accepts an equivalent `--flag`.
#
# Each is shown at its default, commented out: drop the leading `#` to take it
# over. Paths and URLs have an example instead — those have no default worth
# pre-filling.
# ---------------------------------------------------------------------------

# Where the databases + secrets live [per-OS app dir]
# CC_SERVER_DATA_DIR=/var/lib/control-center

# TCP port
# CC_SERVER_PORT=9030

# loopback | any — `any` needs TLS, or CC_SERVER_INSECURE
# CC_SERVER_BIND=loopback

# The ws(s):// URL clients are told to dial [derived from the bind]
# CC_SERVER_PUBLIC_URL=wss://cc.example.com/rpc

# How this server introduces itself [its identity name]
# CC_SERVER_NAME=my-server

# Comma-separated dirs the repo picker may browse [none]
# CC_SERVER_REPO_ROOTS=/home/me/code,/srv/repos

# Comma-separated browser origins allowed to dial /rpc
# CC_SERVER_ALLOWED_ORIGINS=https://app.usectrl.dev

# Relay broker for phone clients
# CC_SERVER_SIGNALING_URL=wss://signaling.usectrl.dev

# Where SSO bounces the browser back to
# CC_SERVER_WEB_CLIENT_URL=https://app.usectrl.dev

# PEM cert chain + private key — with both, serves wss:// directly
# CC_SERVER_TLS_CERT=/etc/ssl/cc/fullchain.pem
# CC_SERVER_TLS_KEY=/etc/ssl/cc/privkey.pem

# Allow a non-loopback bind with no TLS
# CC_SERVER_INSECURE=false

# debug | info | warning | error
# CC_SERVER_LOG_LEVEL=warning

# on | off — the agent sandbox
# CC_SERVER_SANDBOX=on

# on | off — the code-graph indexing kill switch
# CC_SERVER_CODE_INDEX=on

# Seconds to hold the first index sweep [max 300]
# CC_SERVER_CODE_INDEX_DEFER=15

# auto | on | off — LAN discovery
# CC_SERVER_MDNS=auto

# none | cloudflare | tailscale, and how to run it
# CC_SERVER_TUNNEL=none
# CC_SERVER_TUNNEL_BINARY=/usr/local/bin/cloudflared
# CC_SERVER_TUNNEL_ARGS=
