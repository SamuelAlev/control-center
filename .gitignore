# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
dist

# Release job scratch, written at the repo root: make_release.sh assembles
# release/ and gen_appcast.sh writes the two signed feeds beside it.
/release/
/appcast.xml
/appcast-windows.xml

# Updater signing PRIVATE keys. Only the public halves are committed
# (dsa_pub.pem, and SUPublicEDKey in macos/Runner/Info.plist); the private ones
# live in the SPARKLE_* repository secrets. Committing one to this PUBLIC repo
# would force a key rotation that strands every already-installed client, so it
# is ignored by name rather than left to care — WinSparkle's own generate_keys
# writes dsa_priv.pem into the working directory.
/dsa_priv.pem
/dsaparam.pem
/*.p12
/*.pfx

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Generated isolate_manager Web Workers: the compiled `web/<name>.js` IS
# committed (so `flutter build web` needs no code generator), but the dart2js
# build sidecars are noise — regenerate via tool/gen_workers.sh.
web/*.js.deps
web/*.js.map

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Credentials and secrets
.env
.env.*
!.env.template
**/secrets.*

# The pristine copy scripts/release/builtin_credentials.sh sets aside while the
# real credentials sit in builtin_credentials.dart. Its presence means the
# TRACKED file currently holds secrets — ignoring the backup keeps a mid-build
# `git add -A` from committing it too.
packages/cc_server_core/lib/src/builtin_credentials.dart.orig

coverage

sentry.properties

# Local per-developer macOS signing override (see macos/scripts/create_local_signing_cert.sh)
macos/Runner/Configs/Signing.local.xcconfig

# macOS Developer ID provisioning profile (see scripts/release/macos_package.sh).
# Holds no private key, but kept out of the tree — CI embeds it from the
# MACOS_PROVISIONING_PROFILE_BASE64 secret; locally it's the default-path fallback.
macos/Control_Center__macOS.provisionprofile

# Release build artifacts written to the repo root by the release scripts.
/Control-Center-*
/cc_server-*

# Docker build contexts staged by the release `containers` job (the CI-extracted
# cc_server bundle + the pre-built Flutter web bundles). Generated, never committed.
/docker/cc_server/bundle/
/docker/web/site/
/docker/cc_remote/site/

# FVM Version Cache
.fvm/

# Cloudflare
.wrangler

# patchwork (third-party dependency patching). The committed artifacts are
# `patches/*.patch` + `patchwork.lock`; the rest is generated locally and
# re-materialized by `dart run patchwork apply` / the root build hook.
.patchwork/
.dart_tool/patchwork/
pubspec_overrides.yaml

# Local-only knobs for apps/cc_server/hook/build.dart (see its doc): opt out of
# the required-natives gate, or point it at a different staging dir.
.cc_natives_allow_missing
.cc_natives_prebuilt_dir
