---
/**
 * /compare/[slug] — one page per competitor ("Control Center vs Conductor",
 * …), generated from the same data as the matrix so cells, blurbs and verdicts
 * never drift. Each page: direct-answer verdict up front (what snippets and
 * answer engines lift), a two-column capability table, the honest case for
 * each side, a tool-specific FAQ with FAQPage JSON-LD, and the internal link
 * back to the hub matrix.
 */
import type { GetStaticPaths } from 'astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import StructuredData from '../../components/shared/StructuredData.astro';
import LandingScripts from '../../components/landing/LandingScripts.astro';
import { columns, tools, vsTools, compareReviewed, trackedUrl } from '../../data/compare';

export const getStaticPaths = (() => vsTools.map((tool) => ({ params: { slug: tool.id } }))) satisfies GetStaticPaths;

const tool = vsTools.find((t) => t.id === Astro.params.slug)!;
const cc = tools[0];

const glyph = { yes: '✓', partial: '≈', no: '—' } as const;
const cellLabel = { yes: 'Yes', partial: 'Partial', no: 'No' } as const;

const faqs = [
  {
    question: `What is the difference between Control Center and ${tool.name}?`,
    answer: tool.verdict!,
  },
  {
    question: `When should I choose ${tool.name} over Control Center?`,
    answer: `${tool.bestFor}${tool.footnote ? ` (${tool.footnote})` : ''}`,
  },
  {
    question: `When should I choose Control Center over ${tool.name}?`,
    answer: tool.ccEdge!,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const rows = columns.filter((c) => cc.cells[c.id] !== tool.cells[c.id] || cc.cells[c.id] === 'yes');
---

<MarketingLayout
  title={`Control Center vs ${tool.name} \\ Control Center`}
  description={`${tool.verdict!} An honest capability comparison — parallel agents, PR review, pipelines, meetings, self-hosting and multiplayer, side by side.`}
  breadcrumbName={`vs ${tool.name}`}
>
  <main id="top">
    <!-- Verdict first: the direct answer, for extraction. -->
    <section class="border-b border-border py-[clamp(56px,9vw,88px)]">
      <div class="wrap">
        <div class="reveal max-w-[72ch]">
          <span class="eyebrow">Compare</span>
          <h1 class="mt-4 text-[clamp(30px,4.4vw,56px)] font-semibold leading-[1.0] tracking-[-0.03em]">Control Center vs {tool.name}.</h1>
          <p class="mt-[22px] max-w-[64ch] text-[clamp(16px,1.4vw,18px)] leading-[1.6] text-muted">{tool.verdict}</p>
          <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.08em] text-idle">Checked against {tool.name}’s public site · {compareReviewed}</p>
        </div>
      </div>
    </section>

    <!-- Two-column capability table. -->
    <section class="py-[clamp(56px,9vw,88px)]">
      <div class="wrap">
        <div class="reveal max-w-[62ch]">
          <h2 class="text-[clamp(24px,3.2vw,40px)] font-semibold leading-[1.05] tracking-[-0.025em]">Side by side.</h2>
          <p class="mt-[14px] max-w-[52ch] text-[15px] leading-[1.6] text-muted">
            <span class="font-mono">✓</span> yes · <span class="font-mono">≈</span> partial · <span class="font-mono">—</span> not offered.
          </p>
        </div>

        <div class="reveal mt-[clamp(24px,3.5vw,40px)] overflow-x-auto border border-border rounded-lg">
          <table class="w-full min-w-[560px] border-collapse text-left">
            <caption class="sr-only">Control Center and {tool.name} compared across {rows.length} capabilities</caption>
            <thead>
              <tr class="border-b border-border bg-surface">
                <th scope="col" class="px-4 py-3 font-mono text-[10.5px] font-medium uppercase tracking-[0.08em] text-idle">Capability</th>
                <th scope="col" class="px-3 py-3 text-center font-mono text-[10.5px] font-medium uppercase tracking-[0.08em] text-accent">Control Center</th>
                <th scope="col" class="px-3 py-3 text-center font-mono text-[10.5px] font-medium uppercase tracking-[0.08em] text-idle">{tool.name}</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((c) => (
                <tr class="border-b border-border last:border-0 bg-panel">
                  <th scope="row" class="px-4 py-[13px] text-[13.5px] font-normal text-fg">{c.label}</th>
                  {[cc.cells[c.id], tool.cells[c.id]].map((value) => (
                    <td class="px-3 py-[13px] text-center">
                      <span class:list={['font-mono text-[14px]', value === 'yes' ? 'text-accent' : value === 'partial' ? 'text-muted' : 'text-idle']} aria-label={cellLabel[value]}>{glyph[value]}</span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {tool.footnote && (
          <p class="reveal mt-4 max-w-[72ch] font-mono text-[11px] leading-[1.6] text-idle">How {tool.name}’s partial cells read: {tool.footnote}</p>
        )}
      </div>
    </section>

    <!-- The honest case for each side. -->
    <section class="border-t border-border py-[clamp(56px,9vw,88px)]">
      <div class="wrap grid grid-cols-1 gap-5 md:grid-cols-2">
        <div class="reveal rounded-lg border border-[color-mix(in_oklab,var(--color-accent),transparent_55%)] bg-accent-soft p-6 shadow-soft">
          <h2 class="m-0 text-[18px] font-semibold leading-[1.25] tracking-[-0.01em]">Where Control Center pulls ahead</h2>
          <p class="mb-0 mt-3 text-[14px] leading-[1.65] text-muted">{tool.ccEdge}</p>
        </div>
        <div class="reveal rounded-lg border border-border bg-panel p-6 shadow-soft">
          <h2 class="m-0 text-[18px] font-semibold leading-[1.25] tracking-[-0.01em]">Where {tool.name} pulls ahead</h2>
          <p class="mb-0 mt-3 text-[14px] leading-[1.65] text-muted">{tool.bestFor}</p>
          <p class="mb-0 mt-4"><a class="text-fg text-[13px] underline underline-offset-4 decoration-border hover:decoration-fg" href={trackedUrl(tool)} target="_blank" rel="noopener noreferrer">{tool.name}’s own site <span aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </section>

    <!-- FAQ. -->
    <section class="border-t border-border py-[clamp(56px,9vw,88px)]">
      <div class="wrap max-w-[72ch]">
        <div class="reveal">
          <span class="eyebrow">Questions</span>
          <h2 class="mt-4 text-[clamp(24px,3.2vw,40px)] font-semibold leading-[1.05] tracking-[-0.025em]">Choosing between them.</h2>
        </div>
        {faqs.map((f) => (
          <div class="reveal border-b border-border py-[clamp(20px,2.6vw,28px)]">
            <h3 class="m-0 text-[16.5px] font-semibold leading-[1.3] tracking-[-0.01em]">{f.question}</h3>
            <p class="mb-0 mt-3 text-[14.5px] leading-[1.65] text-muted">{f.answer}</p>
          </div>
        ))}
        <p class="reveal mt-8 text-sm text-muted">
          See every tool on one grid on the <a class="text-fg underline underline-offset-2 decoration-border hover:decoration-fg" href="/compare/">full comparison page</a>,
          or <a class="text-fg underline underline-offset-2 decoration-border hover:decoration-fg" href="/#install">download Control Center</a> and feel it.
        </p>
      </div>

      <StructuredData schema={schema} />
    </section>
  </main>

  <LandingScripts />
</MarketingLayout>
