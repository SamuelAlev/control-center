---
/**
 * The hero cloudscape veil — one tuned wrapper around ShaderBackground so
 * every page hero (landing, changelog, developers, about, contact, compare,
 * legal) is the same brand moment, instead of each section re-deriving its own
 * opacity and mask.
 *
 * The host section must be `relative overflow-hidden`, and its content must
 * sit above the veil on `relative z-[2]`.
 *
 * `band` (default) fades in beneath a bounded page header and holds the warm
 * horizon at its bottom edge. `landing` extends above its hero into the
 * transparent sticky navigation, then fades before the following section;
 * the host must allow that top overflow. Its nearest cloud deck rests just
 * below the pilot, above the product showcase that covers the lower canvas.
 */
import ShaderBackground from './ShaderBackground.astro';

interface Props {
  variant?: 'band' | 'landing';
}

const { variant = 'band' } = Astro.props;
---

<div class="cc-hero-veil" data-variant={variant} aria-hidden="true">
  <ShaderBackground horizon={variant === 'landing' ? 0.42 : 0.95} />
</div>

<style>
  .cc-hero-veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%);
    mask-image: linear-gradient(180deg, transparent, #000 30%);
  }

  .cc-hero-veil[data-variant="landing"] {
    inset-block-start: -72px;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%);
  }

  @media (max-width: 900px) {
    .cc-hero-veil[data-variant="landing"] { inset-block-start: -64px; }
  }
</style>
