---
/**
 * The hero cloudscape veil — one tuned wrapper around ShaderBackground so
 * every page hero (landing, changelog, developers, about, contact, compare,
 * legal) is the same brand moment, instead of each section re-deriving its own
 * opacity and mask.
 *
 * The host section must be `relative overflow-hidden`, and its content must
 * sit above the veil on `relative z-[2]`.
 *
 * Two closes, because a hero ends in one of two ways:
 *  - `band` (default) — fades in under the sticky nav and runs at full
 *    strength to the section's bottom edge, where a hairline border closes it.
 *    The scene's warm horizon lives at the BOTTOM of the canvas (uv.y is
 *    flipped in the shader), so this is the shape that actually shows it.
 *    Every bounded header uses it.
 *  - `fade` — fades in and back out again, for a hero that flows on into the
 *    page with no hairline to close it (the landing hero, which runs into the
 *    app capture). Trades the last of the horizon for an edge that isn't
 *    there; give the host enough bottom padding for the taper.
 */
import ShaderBackground from './ShaderBackground.astro';

interface Props {
  variant?: 'band' | 'fade';
}

const { variant = 'band' } = Astro.props;
---

<div class="cc-hero-veil" data-variant={variant} aria-hidden="true">
  <ShaderBackground />
</div>

<style>
  .cc-hero-veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%);
    mask-image: linear-gradient(180deg, transparent, #000 30%);
  }

  .cc-hero-veil[data-variant="fade"] {
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent,
      #000 22%,
      #000 72%,
      transparent
    );
    mask-image: linear-gradient(
      180deg,
      transparent,
      #000 22%,
      #000 72%,
      transparent
    );
  }
</style>
