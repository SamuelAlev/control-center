---
import { REPO_URL } from '../../data/site';

interface Props { label: string; class?: string }
const { label, class: className = '' } = Astro.props;
---
<a class:list={['repo-star', className]} href={REPO_URL} target="_blank" rel="noopener noreferrer">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" width="16" height="16"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z" /></svg>
  <span>{label}</span><span class="repo-star-count" data-repo-star-count hidden></span>
</a>
<style>
  .repo-star { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-block-size: 44px; padding-inline: 12px; border: 1px solid var(--cc-border); color: var(--cc-fg); background: var(--cc-panel); font-size: 13px; font-weight: 600; line-height: 1; text-decoration: none; white-space: nowrap; }
  .repo-star:hover { border-color: var(--cc-fg); }
  .repo-star-count { padding-inline-start: 8px; border-inline-start: 1px solid var(--cc-border); font-weight: 400; font-variant-numeric: tabular-nums; }
  .repo-star-count[hidden] { display: none; }
  .repo-star:focus-visible { outline: 2px solid var(--cc-accent); outline-offset: 3px; }
  @media (forced-colors: active) { .repo-star { border-color: ButtonText; } }
  @media (max-width: 900px) { .repo-star.landing-nav-star { display: none; } }
</style>
