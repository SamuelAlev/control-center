---
/**
 * Starlight `Head` override — renders Starlight's built-in head (title, meta
 * description, canonical, OpenGraph, sitemap link, …) unchanged, then appends
 * per-page JSON-LD: a `TechArticle` describing the doc and a `BreadcrumbList`
 * trail, and the WebMCP tool registration every page on this origin carries
 * (see components/shared/WebMcpScript.astro). Registered via `components.Head`
 * in astro.config.mjs, alongside the other Starlight component overrides.
 *
 * Breadcrumb URLs use the current locale's landing page and manual index.
 * Section levels like `/manual/guides/` have no index, so the trail
 * includes only existing landing, manual index and article pages.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import StructuredData from '../shared/StructuredData.astro';
import WebMcpScript from '../shared/WebMcpScript.astro';
import AcquisitionScript from '../shared/AcquisitionScript.astro';
import SiteLocaleScript from '../shared/SiteLocaleScript.astro';
import { cdn } from '../../data/cdn';
import { landingPath, localeFromPath, manualPath } from '../../data/locales';

const { starlightRoute } = Astro.locals;
const { entry, entryMeta } = starlightRoute;
const locale = localeFromPath(Astro.url.pathname);
const siteHref = new URL('/', Astro.site).href;
const landingHref = new URL(landingPath(locale), Astro.site).href;
const docsHref = new URL(manualPath(locale), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const { title, description, datePublished, dateModified } = entry.data;

// The 404 entry isn't a real article — skip structured data there.
const isError = entry.id === '404' || entry.id.endsWith('/404');

const crumbs = [{ name: Astro.locals.t('docs.home'), item: landingHref }];
if (canonical !== docsHref) crumbs.push({ name: Astro.locals.t('docs.documentation'), item: docsHref });
crumbs.push({ name: title, item: canonical });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    ...(description ? { description } : {}),
    url: canonical,
    // Freshness signals — emitted only when the frontmatter carries them, so
    // a date is never fabricated. See src/content.config.ts.
    ...(datePublished ? { datePublished: datePublished.toISOString() } : {}),
    ...(dateModified ? { dateModified: dateModified.toISOString() } : {}),
    inLanguage: entryMeta.lang,
    isPartOf: { '@type': 'WebSite', name: 'Control Center', url: siteHref },
    publisher: {
      '@type': 'Organization',
      name: 'Control Center',
      url: siteHref,
      logo: cdn.favicon,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: c.item,
    })),
  },
];
---

<Default><slot /></Default>
{isError && <meta name="robots" content="noindex, follow" />}
{!isError && <StructuredData schema={schema} />}
{/* WebMCP tools on every docs page — the marketing half is covered by
    MarketingLayout. Unconditional: the tools are just as useful from the
    404 page, where an agent most needs to find the right route. */}
<WebMcpScript />
<AcquisitionScript />
<SiteLocaleScript />
