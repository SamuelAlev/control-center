---
import StructuredData from '../shared/StructuredData.astro';
import type { LandingCopy } from '../../data/landing';
import type { SiteLocale } from '../../data/locales';
interface Props { copy: LandingCopy; locale: SiteLocale }
const { copy: t, locale } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', url: new URL(Astro.url.pathname, Astro.site).href, inLanguage: locale, mainEntity: t.faq.items.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<section class="landing-faq landing-section" id="faq" aria-labelledby="faq-title">
  <div class="landing-wrap">
    <header class="section-intro"><h2 id="faq-title">{t.faq.title}</h2><p>{t.faq.description}</p></header>
    <div class="faq-grid">{t.faq.items.map(faq => <article><h3>{faq.question}</h3><p>{faq.answer}</p>{faq.links?.map(link => <a class="landing-text-link" href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>)}</article>)}</div>
  </div>
  <StructuredData schema={schema} />
</section>
