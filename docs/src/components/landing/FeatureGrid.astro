---
import ProductMedia from './ProductMedia.astro';
import { featureCaptureFor } from '../../data/captures';
import type { LandingCopy } from '../../data/landing';
import { localeFromPath } from '../../data/locales';
import { localizeSitePath } from '../../data/manual-paths';
import { getManualRoutes } from '../../data/manual-routes';
interface Props { copy: LandingCopy }
const { copy: t } = Astro.props;
// Manual links go straight to this language's translated page.
const routes = await getManualRoutes();
const localized = (href: string) => localizeSitePath(href, localeFromPath(Astro.url.pathname), routes);
---
<section class="landing-features landing-section" id="features" aria-labelledby="features-title">
  <div class="landing-wrap">
    <header class="section-intro"><h2 id="features-title">{t.grid.title}</h2><p>{t.grid.description}</p></header>
    <div class="landing-feature-grid">
      {t.grid.items.map((item, i) => {
        const capture = featureCaptureFor(item.kind);
        return <article id={item.kind === 'meetings' ? 'day' : undefined} class:list={['landing-feature', `feature-${item.kind}`, { 'feature-wide': i >= t.grid.items.length - 2 }]} data-enter style={`--enter-order:${i % 3}`}>
        <div class="feature-media"><ProductMedia kind={`feature-${item.kind}`} description={'alt' in item ? item.alt : t.tour.stops.find(stop => stop.kind === item.kind)!.alt} label={t.tour.imageLanguage} capture={capture} playback={capture ? 'thumb' : 'inline'} playLabel={t.tour.videoPlay} closeLabel={t.tour.close} compact /></div>
        <div class="feature-copy"><h3>{item.title}</h3><p>{item.description}</p><a class="landing-text-link" href={localized(item.href)}>{item.link}<span aria-hidden="true">↗</span></a></div>
      </article>;
      })}
      {t.grid.supporting.map(item => <article class="landing-feature feature-supporting">
        <div class="feature-copy"><h3><a href={localized(item.href)}>{item.title}<span aria-hidden="true">↗</span></a></h3><p>{item.description}</p></div>
      </article>)}
    </div>
    <a class="feature-docs-link landing-text-link" href={localized('/manual/')}>{t.grid.more}<span aria-hidden="true">↗</span></a>
  </div>
</section>
