---
import BrandMark from '../shared/BrandMark.astro';
import RepoStar from '../shared/RepoStar.astro';
import { DEMO_HREF } from '../../data/demo';
import type { LandingCopy } from '../../data/landing';
import { landingPath, manualPath, type SiteLocale } from '../../data/locales';
import { repoStarLabels } from '../../data/repo-star-label';
import '../../styles/navigation.css';
interface Props { copy: LandingCopy; locale: SiteLocale; embedded?: boolean; starLabel?: string }
const { copy: t, locale, embedded = false, starLabel = repoStarLabels[locale] } = Astro.props;
const home = landingPath(locale);
const section = (hash: string) => Astro.url.pathname === home ? hash : `${home}${hash}`;
const Container = embedded ? 'div' : 'header';
const links = [
  { href: section('#product'), text: t.nav.product },
  { href: section('#workflows'), text: t.nav.workflows },
  { href: section('#features'), text: t.nav.features },
  { href: manualPath(locale), text: t.nav.docs },
];
---
<Container class:list={['landing-nav', { 'landing-nav--embedded': embedded }]} id="nav">
  <div class="landing-nav-inner">
    <a class="landing-brand" href={landingPath(locale)} aria-label={t.nav.home}><BrandMark /><span>Control Center</span></a>
    <nav class="landing-nav-links" aria-label={t.nav.primary}>
      {links.map(link => <a href={link.href}>{link.text}</a>)}
    </nav>
    <div class="landing-nav-actions">
      <RepoStar label={starLabel} class="landing-nav-star" />
      <a class="landing-nav-download" href={section('#install')} data-acquisition-event="install_section_click" data-acquisition-placement="nav" data-acquisition-platform="none">{t.nav.download}<span aria-hidden="true">↓</span></a>
      <details class="landing-mobile-menu" data-landing-disclosure>
        <summary>{t.nav.menu}<span aria-hidden="true">+</span></summary>
        <nav aria-label={t.nav.mobile}>
          {links.map(link => <a href={link.href}>{link.text}<span aria-hidden="true">↗</span></a>)}
          <a href={DEMO_HREF} data-acquisition-event="demo_open_click" data-acquisition-placement="nav" data-acquisition-platform="none">{t.nav.demo}<span aria-hidden="true">↗</span></a>
          <RepoStar label={starLabel} />
          <a href={section('#install')} data-acquisition-event="install_section_click" data-acquisition-placement="nav" data-acquisition-platform="none">{t.nav.download}<span aria-hidden="true">↓</span></a>
        </nav>
      </details>
    </div>
  </div>
</Container>

<script>
  import '../../scripts/landing-disclosures';
</script>
