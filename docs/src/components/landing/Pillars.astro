---
/**
 * Pillars — the four headline surfaces as alternating copy/screenshot splits.
 * Copy carried over from the previous capabilities/tickets/meetings bands;
 * visuals are placeholder slots awaiting real captures. The captures are
 * briefed in src/data/shots.ts, shared with the hero carousel so a screen is
 * described once.
 */
import ScreenshotSlot from './ScreenshotSlot.astro';
import { shots } from '../../data/shots';

const tick = '<path d="M3 8.5 6.5 12 13 4"/>';

const pillars = [
  {
    id: 'agents',
    eyebrow: 'Agents',
    head: 'See what every agent is doing.',
    body: 'Each agent runs on its own branch, in its own copy-on-write worktree. Thinking, running, blocked, failed, idle: every state reads differently at a glance, with live token cost and last-output age per run.',
    bullets: [
      'Presence is earned by representing the agent model truthfully, never by decoration.',
      'Steer a run mid-flight, take over, or hand it back.',
      'Ownership and attribution stay legible as teammates join.',
    ],
    shot: shots.agents,
  },
  {
    id: 'rigs',
    eyebrow: 'Rigs',
    head: 'Hand an agent a whole machine, safely.',
    body: 'When an agent needs to actually try something — load the page, click through the app, run the risky command — it opens a rig: a disposable VM with its own kernel, a throwaway disk and a network that reaches only the hosts you allowed. You watch it work live and take the controls at any time.',
    bullets: [
      'A browser, a Linux desktop, a phone, or an enclosed terminal — booted in seconds, scoped to the conversation you share.',
      'Start a dev server inside and it is on localhost, in the agent’s browser and under https://myapp.test moments later.',
      'git push works with no credential in the VM; every input lands in an audit log with its author.',
      'Nothing inside ever touches your machine, and the disk is destroyed on close.',
    ],
    shot: shots.rigs,
  },
  {
    id: 'review',
    eyebrow: 'Review',
    head: 'Review and merge what the fleet ships.',
    body: 'Priority pull requests surface first, from every forge at once. Read the diff, drop inline comments, dispatch reviewer agents and land a ship / hold / block verdict without leaving the deck.',
    bullets: [
      'One inbox across GitHub, GitLab and Bitbucket.',
      'Inline threads synced back to the forge, with suggested edits.',
      'AI reviewers with P0–P3 findings and a rolled-up verdict.',
      'An ephemeral focus mode for distraction-free review.',
    ],
    shot: shots.review,
  },
  {
    id: 'meetings',
    eyebrow: 'Meetings & calendar',
    head: 'Your day and your meetings, on the same deck.',
    body: 'Record a call and the deck transcribes it on-device, separates the speakers and writes the summary, decisions and action items. Connect Google Calendar to see your day and turn any event into a recorded, summarized meeting.',
    bullets: [
      'On-device transcription and diarization; audio never leaves your machine.',
      'Google Calendar in month, week and agenda views, with RSVP.',
      'A heads-up before each meeting and record-and-link straight from an event.',
    ],
    shot: shots.meetings,
  },
  {
    id: 'pipelines',
    eyebrow: 'Pipelines',
    head: 'Orchestrate the fleet as a DAG.',
    body: 'Compose steps into a graph: prompt an agent, run a script, fan out reviewers, join the results. Runs start by hand, on a schedule, or off a domain event and every node carries its own retry and continue-on-fail policy.',
    bullets: [
      'Three triggers: manual, scheduled, or domain-event.',
      'Router and join nodes for conditional, parallel work.',
      'Resumable runs that survive a restart mid-flight.',
    ],
    shot: shots.pipelines,
  },
];
---

<section id="pillars" class="border-t border-border py-[clamp(56px,9vw,88px)]">
  <div class="wrap">
    <div class="reveal max-w-[62ch]">
      <span class="eyebrow">Every stream of work</span>
      <h2 class="mt-4 text-[clamp(30px,4.4vw,56px)] font-semibold leading-[1.0] tracking-[-0.03em]">One deck for the whole operation.</h2>
      <p class="mt-[18px] max-w-[48ch] text-[clamp(16px,1.4vw,18px)] text-muted">Agents are one pillar among co-equal ones. The same vocabulary (status, ownership, next action) carries across all of them.</p>
    </div>

    <div class="mt-[clamp(36px,5vw,56px)] flex flex-col gap-[clamp(44px,6vw,72px)]">
      {pillars.map((p, i) => (
        <div id={p.id} class="grid scroll-mt-[calc(var(--nav-h)+16px)] grid-cols-1 items-center gap-[30px] lg:grid-cols-2 lg:gap-[clamp(32px,5vw,72px)]">
          <div class:list={['reveal', i % 2 === 1 ? 'lg:order-2 from-right' : 'from-left']}>
            <span class="eyebrow">{p.eyebrow}</span>
            <h3 class="mt-3 max-w-[18ch] text-[clamp(24px,2.8vw,34px)] font-semibold leading-[1.04] tracking-[-0.025em]">{p.head}</h3>
            <p class="mt-4 max-w-[40em] text-[clamp(15px,1.3vw,17px)] text-muted">{p.body}</p>
            <ul class="m-0 mt-[22px] flex list-none flex-col gap-3 p-0">
              {p.bullets.map((b) => (
                <li class="flex items-start gap-[11px] text-[15px]">
                  <svg class="mt-[2px] h-4 w-4 flex-none text-fg" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" set:html={tick} />
                  {b}
                </li>
              ))}
            </ul>
          </div>
          <ScreenshotSlot
            class={i % 2 === 1 ? 'lg:order-1 from-left' : 'from-right'}
            n={p.shot.n}
            title={p.shot.title}
            file={p.shot.file}
            description={p.shot.description}
          />
        </div>
      ))}
    </div>
  </div>
</section>
