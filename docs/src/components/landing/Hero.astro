---
import { DEMO_HREF } from '../../data/demo';
import HeroShader from '../shared/HeroShader.astro';
import HeroCarousel from './HeroCarousel.astro';
---

<section>
  <!-- The cloudscape breathes behind the headline and tapers out before the
       capture: the shot below is an opaque full-width slab, so a band that ran
       to full strength under it would only ever show in the gutters, and there
       is no hairline here to close one against. Hence `fade`. -->
  <div class="relative overflow-hidden pt-[clamp(44px,6vw,72px)] pb-[clamp(28px,4vw,44px)]">
    <HeroShader variant="fade" />

    <div class="wrap relative z-[2] flex flex-col items-center text-center">
      <!-- Zed-style announcement microline -->
      <a
        class="reveal text-[13.5px] text-muted no-underline transition-colors hover:text-fg"
        href="#install"
      >
        Now on macOS, Windows, Linux and web <span aria-hidden="true">→</span>
      </a>

      <h1 class="reveal mt-[18px] max-w-[18ch] text-[clamp(40px,7.4vw,88px)] font-semibold leading-[1.0] tracking-[-0.03em]">
        Run a fleet,<br /><span class="text-idle">command the operation.</span>
      </h1>

      <p class="reveal mt-[22px] max-w-[56ch] text-[clamp(15px,1.4vw,18px)] leading-[1.6] text-muted">
        Control Center is the native deck for your whole developer operation. Dispatch coding agents onto isolated worktrees, review what they ship and keep tickets, meetings and pipelines in one quiet, well-instrumented place.
      </p>

      <div class="reveal mt-[30px] flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href={DEMO_HREF}>Try the live demo</a>
        <a class="btn btn-line" href="#install">Download</a>
        <a class="btn btn-line" href="https://github.com/SamuelAlev/control-center" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.6 0 0 3.6 0 8c0 3.5 2.3 6.5 5.5 7.6.4.1.5-.2.5-.4v-1.4C3.8 14 3.3 12.7 3.3 12.7c-.3-.8-.8-1-.8-1-.6-.4 0-.4 0-.4.7 0 1.1.7 1.1.7.6 1.1 1.7.8 2.1.6 0-.5.3-.8.5-1-1.8-.2-3.6-.9-3.6-3.9 0-.9.3-1.6.8-2.1 0-.2-.3-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.4 1.1.1 1.9.1 2.1.5.5.8 1.2.8 2.1 0 3-1.8 3.7-3.6 3.9.3.3.6.8.6 1.6v2.3c0 .2.1.5.5.4A8 8 0 0016 8c0-4.4-3.6-8-8-8Z"/></svg>
          See source
        </a>
      </div>

      <p class="reveal mt-[22px] font-mono text-xs tracking-[0.03em] text-idle">
        Free and open source · macOS, Windows, Linux and web · No account needed for the demo
      </p>
    </div>
  </div>

  <!-- Hero capture. The gap to the headline block is unchanged: the veil's
       taper padding above plus this margin sum to the old clamp(36px,5vw,56px).
       The rail is a lighter object than the slab it replaces at the top of the
       block, so it carries a touch more air. -->
  <div class="wrap mt-[clamp(10px,1.4vw,18px)]">
    <HeroCarousel ratio="16 / 8.2" />
  </div>

  <!-- Quiet counters band (Zed-style): hairline grid, no fill. -->
  <div class="mt-[clamp(40px,6vw,64px)] border-y border-border">
    <div class="wrap grid grid-cols-2 lg:grid-cols-4">
      <div class="border-l border-border px-5 py-6 first:border-l-0 max-lg:[&:nth-child(3)]:border-l-0 max-lg:[&:nth-child(n+3)]:border-t max-lg:[&:nth-child(n+3)]:border-border">
        <div class="num text-[clamp(24px,2.6vw,34px)] font-semibold leading-none tracking-[-0.02em]">100+</div>
        <div class="mt-2 text-[13px] text-muted">MCP tools, spoken by any client</div>
      </div>
      <div class="border-l border-border px-5 py-6 max-lg:[&:nth-child(n+3)]:border-t max-lg:[&:nth-child(n+3)]:border-border">
        <div class="num text-[clamp(24px,2.6vw,34px)] font-semibold leading-none tracking-[-0.02em]">0</div>
        <div class="mt-2 text-[13px] text-muted">Cloud dependencies; ML runs on-device</div>
      </div>
      <div class="border-l border-border px-5 py-6 max-lg:[&:nth-child(n+3)]:border-t max-lg:[&:nth-child(n+3)]:border-border">
        <div class="num text-[clamp(24px,2.6vw,34px)] font-semibold leading-none tracking-[-0.02em]">3</div>
        <div class="mt-2 text-[13px] text-muted">Clients: desktop, web and phone</div>
      </div>
      <div class="border-l border-border px-5 py-6 max-lg:[&:nth-child(n+3)]:border-t max-lg:[&:nth-child(n+3)]:border-border">
        <div class="num text-[clamp(24px,2.6vw,34px)] font-semibold leading-none tracking-[-0.02em]">1</div>
        <div class="mt-2 text-[13px] text-muted">Server, the single source of truth</div>
      </div>
    </div>
  </div>
</section>
