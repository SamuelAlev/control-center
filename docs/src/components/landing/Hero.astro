---
import HeroShader from '../shared/HeroShader.astro';
import HeroCarousel from './HeroCarousel.astro';
import Paraglider from './Paraglider.astro';
import { DEMO_HREF } from '../../data/demo';
import type { LandingCopy } from '../../data/landing';
interface Props { copy: LandingCopy }
const { copy: t } = Astro.props;
---
<section class="landing-hero" aria-labelledby="hero-title">
  <HeroShader variant="landing" />
  <div class="landing-wrap hero-copy">
    <div class="hero-message">
      <h1 id="hero-title">{t.hero.line1}<br /><span>{t.hero.line2.replaceAll('Control Center', 'Control\u00a0Center')}</span></h1>
      <p class="hero-description">{t.hero.description}</p>
      <div class="hero-actions">
        <a class="landing-button" href="#install" data-acquisition-event="install_section_click" data-acquisition-placement="hero" data-acquisition-platform="none">{t.hero.download}<span aria-hidden="true">↓</span></a>
        <a class="landing-text-link" href={DEMO_HREF} data-acquisition-event="demo_open_click" data-acquisition-placement="hero" data-acquisition-platform="none">{t.hero.demo}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <Paraglider copy={t} variant="hero" />
  </div>
  <div class="hero-showcase landing-wrap" id="product">
    <div class="signal-field" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <HeroCarousel copy={t} />
    <div class="hero-platforms"><span>{t.hero.platforms}</span><span>{t.hero.web}</span></div>
  </div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('.landing-hero');
  const nav = document.querySelector<HTMLElement>('.landing-nav');

  if (hero && nav) {
    const updateNavSurface = () => {
      nav.classList.toggle('landing-nav--over-hero', window.scrollY < hero.offsetTop);
    };
    updateNavSurface();
    window.addEventListener('scroll', updateNavSurface, { passive: true });
  }
</script>
