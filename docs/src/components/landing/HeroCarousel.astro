---
import ProductMedia from './ProductMedia.astro';
import type { LandingCopy } from '../../data/landing';
interface Props { copy: LandingCopy }
const { copy: t } = Astro.props;
const { stops } = t.tour;
---
<cc-product-tour class="product-tour" aria-label={t.tour.label} data-play={t.tour.play} data-pause={t.tour.pause}>
  <div class="tour-tab-controls" hidden>
    <div class="tour-tabs" role="tablist" aria-label={t.tour.label}>
      {stops.map((stop, i) => <button type="button" role="tab" id={`tour-tab-${stop.kind}`} aria-controls={`tour-panel-${stop.kind}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tour-tab><span>{stop.label}</span><span class="tour-progress" aria-hidden="true"></span></button>)}
    </div>
  </div>
  <div class="tour-window">
    <div class="tour-window-bar"><span class="tour-window-mark" aria-hidden="true">⌘</span><span>Control Center</span><span class="tour-window-caption">{t.tour.preview}</span><button class="tour-expand" type="button" data-expand hidden>{t.tour.expand}<span aria-hidden="true">↗</span></button></div>
    <div class="tour-stage">
      {stops.map((stop, i) => <section class="tour-panel" role="tabpanel" id={`tour-panel-${stop.kind}`} aria-labelledby={`tour-tab-${stop.kind}`} tabindex="0" data-tour-panel hidden={i !== 0}>
        <ProductMedia kind={`hero-${stop.kind}`} description={stop.alt} label={t.tour.imageLanguage} />
        <div class="tour-copy"><h2>{stop.title}</h2><p>{stop.description}</p></div>
      </section>)}
    </div>
    <div class="tour-bottom"><p>{t.tour.note}<span class="sr-only"> {t.tour.imageLanguage}</span></p><div class="tour-controls" hidden>
      <button type="button" data-prev aria-label={t.tour.previous}>←</button>
      <span class="tour-count" aria-hidden="true">01 / 06</span>
      <button type="button" data-next aria-label={t.tour.next}>→</button>
      <button type="button" class="tour-play" data-play-button aria-pressed="false">{t.tour.play}</button>
    </div></div>
  </div>
  <dialog class="tour-dialog" aria-label={t.tour.preview}>
    <div class="tour-dialog-header"><strong data-dialog-title>{stops[0].title}</strong><button type="button" data-close>{t.tour.close}<span aria-hidden="true">×</span></button></div>
    <div data-dialog-media><ProductMedia kind="expanded-preview" description={stops[0].alt} label={t.tour.imageLanguage} /></div>
    <p>{t.tour.note} {t.tour.imageLanguage}</p>
  </dialog>
</cc-product-tour>
<noscript><style>@layer base { html[data-landing] .tour-panel[hidden]{display:block!important} }.tour-panel{border-bottom:1px solid var(--color-border)}</style></noscript>
<script>
  class ProductTour extends HTMLElement {
    connectedCallback() {
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-tour-tab]'));
      const panels = Array.from(this.querySelectorAll<HTMLElement>('[data-tour-panel]'));
      const play = this.querySelector<HTMLButtonElement>('[data-play-button]')!;
      const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let index = 0;
      let playing = false;
      let visible = false;
      let timer: ReturnType<typeof setTimeout> | undefined;
      const stopTimer = () => { clearTimeout(timer); timer = undefined; this.removeAttribute('data-timing'); };
      const sync = () => {
        stopTimer();
        play.textContent = playing ? this.dataset.pause! : this.dataset.play!;
        play.setAttribute('aria-pressed', String(playing));
        if (!playing || !visible || document.hidden || dialog.open || this.matches(':hover') || (this.matches(':focus-within') && document.activeElement !== play)) return;
        this.setAttribute('data-timing', '');
        timer = setTimeout(() => select(index + 1), 8000);
      };
      const select = (next: number, manual = false, focus = false) => {
        index = (next + tabs.length) % tabs.length;
        if (manual) playing = false;
        tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
        panels.forEach((panel, i) => { panel.hidden = i !== index; });
        this.querySelector('.tour-count')!.textContent = `${String(index + 1).padStart(2, '0')} / ${String(tabs.length).padStart(2, '0')}`;
        if (focus) tabs[index].focus({ preventScroll: true });
        // Scroll only the segment rail, never the page containing it.
        const rail = this.querySelector<HTMLElement>('.tour-tabs')!;
        if (rail.scrollWidth > rail.clientWidth) rail.scrollTo({ left: tabs[index].offsetLeft - rail.offsetLeft - (rail.clientWidth - tabs[index].offsetWidth) / 2, behavior: reduced.matches ? 'instant' : 'smooth' });
        sync();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i, true));
        tab.addEventListener('keydown', event => {
          const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : event.key === 'ArrowRight' ? index + 1 : event.key === 'ArrowLeft' ? index - 1 : null;
          if (next !== null) { event.preventDefault(); select(next, true, true); }
        });
      });
      this.querySelector('[data-prev]')!.addEventListener('click', () => select(index - 1, true));
      this.querySelector('[data-next]')!.addEventListener('click', () => select(index + 1, true));
      play.addEventListener('click', () => { playing = !playing; sync(); });
      this.addEventListener('pointerenter', sync);
      this.addEventListener('pointerleave', sync);
      this.addEventListener('focusin', () => { playing = false; sync(); });
      this.addEventListener('focusout', () => queueMicrotask(sync));
      document.addEventListener('visibilitychange', sync);
      reduced.addEventListener('change', () => { playing = false; sync(); });
      const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); });
      observer.observe(this);
      const expand = this.querySelector<HTMLButtonElement>('[data-expand]')!;
      expand.addEventListener('click', () => {
        const source = panels[index].querySelector('[data-media-slot]')!;
        dialog.querySelector('[data-dialog-media]')!.replaceChildren(source.cloneNode(true));
        dialog.querySelector('[data-dialog-title]')!.textContent = panels[index].querySelector('h2')!.textContent;
        playing = false; dialog.showModal(); sync();
        dialog.querySelector<HTMLButtonElement>('[data-close]')!.focus();
      });
      dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', event => { if (event.target === dialog) { const r = dialog.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close(); } });
      dialog.addEventListener('close', () => { expand.focus(); sync(); });
      this.querySelectorAll<HTMLElement>('.tour-tab-controls, .tour-controls, [data-expand]').forEach(el => { el.hidden = false; });
      sync();
      window.addEventListener('pagehide', () => { stopTimer(); observer.disconnect(); });
      window.addEventListener('pageshow', event => { if (event.persisted) observer.observe(this); });
    }
  }
  if (!customElements.get('cc-product-tour')) customElements.define('cc-product-tour', ProductTour);
</script>
