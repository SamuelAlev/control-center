---
import StructuredData from '../components/shared/StructuredData.astro';
import WebMcpScript from '../components/shared/WebMcpScript.astro';
import AcquisitionScript from '../components/shared/AcquisitionScript.astro';
import SiteLocaleScript from '../components/shared/SiteLocaleScript.astro';
import { ISSUES_URL, REPO_URL } from '../data/site';
import '../styles/global.css';
import '../styles/landing.css';
import LandingNav from '../components/landing/LandingNav.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import { landingCopy } from '../data/landing';
import { cdn } from '../data/cdn';
import { siteLanguageDefaults, siteLocales, siteRtl, type SiteLocale } from '../data/locales';

interface Props {
  title: string;
  description?: string;
  /** Social image. An absolute URL, or a site path resolved against Astro.site. */
  ogImage?: string;
  /** Alt text for the social-share image. */
  ogImageAlt?: string;
  /** Emit SoftwareApplication JSON-LD (the landing page only). */
  softwareApplication?: boolean;
  /** Leaf name for a 2-level BreadcrumbList (Home → name), e.g. "Privacy policy". */
  breadcrumbName?: string;
  landingLocale?: SiteLocale;
}

const {
  title,
  description =
    'Control Center is the deck for your whole developer operation: dispatch and review AI coding agents, capture meetings and keep tickets, pipelines and your calendar in one app. Desktop on macOS, Windows, and Linux, plus web and phone.',
  ogImage = cdn.ogImage,
  ogImageAlt = 'Control Center: the developer operations deck.',
  softwareApplication = false,
  breadcrumbName,
  landingLocale,
} = Astro.props;
const isLanding = landingLocale !== undefined;
const locale = landingLocale ?? 'en-US';
const copy = landingCopy[locale];

// Absolute URLs for canonical + social cards. Astro.site comes from
// astro.config.mjs (`site`).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const siteHref = new URL('/', Astro.site).href;

// JSON-LD structured data. Organization + WebSite ship on every marketing
// page; SoftwareApplication is the landing-only product card; BreadcrumbList
// is emitted for the legal/changelog leaves. Starlight doc pages get their
// own TechArticle/BreadcrumbList via the Head override.
const SITE_NAME = 'Control Center';
const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    // Search aliases: "ctrl" is how the product is searched for; the domain
    // is the durable identifier.
    alternateName: ['ctrl', 'usectrl', 'usectrl.dev'],
    url: siteHref,
    logo: cdn.favicon,
    sameAs: [REPO_URL],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: ISSUES_URL,
    },
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'CH',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    alternateName: ['ctrl', 'usectrl.dev'],
    url: siteHref,
    inLanguage: siteLocales.map(language => language.id),
  },
];

if (softwareApplication) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE_NAME,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Windows, Linux',
    url: canonical,
    inLanguage: locale,
    description,
    image: ogImageUrl,
    softwareHelp: new URL('/manual/', Astro.site).href,
    codeRepository: REPO_URL,
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  });
}

if (breadcrumbName) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteHref },
      { '@type': 'ListItem', position: 2, name: breadcrumbName, item: canonical },
    ],
  });
}
---

<!doctype html>
<html lang={locale} dir={siteRtl.has(locale) ? 'rtl' : undefined} data-landing={isLanding ? '' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {isLanding && siteLocales.map(language => <>
    <link rel="alternate" hreflang={language.id} href={new URL(language.path, Astro.site).href} />
    {siteLanguageDefaults.has(language.id) && <link rel="alternate" hreflang={language.id.split('-')[0]} href={new URL(language.path, Astro.site).href} />}
  </>)}
  {isLanding && <link rel="alternate" hreflang="x-default" href={siteHref} />}
  <link rel="icon" href={cdn.favicon} type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="Control Center changelog"
    href="/rss.xml"
  />

  {/* Theme color tracks the operating-system surface without imposing a landing-only palette. */}
  <meta name="theme-color" content="#fcfbf9" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#171614" media="(prefers-color-scheme: dark)" />

  {/* Open Graph */}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={locale.replace('-', '_')} />
  {isLanding && siteLocales.filter(language => language.id !== locale).map(language =>
    <meta property="og:locale:alternate" content={language.id.replace('-', '_')} />
  )}
  <meta property="og:site_name" content="Control Center" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />

  {/* Twitter */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  {/* Structured data (JSON-LD) for rich results + AI answer engines. */}
  <StructuredData schema={schemas} />

  {/* Offer this site's content as WebMCP tools to a browser-resident agent.
      Silent no-op where the API is absent (every browser by default). */}
  <WebMcpScript />
  <AcquisitionScript />
  {isLanding && <SiteLocaleScript />}

  <link rel="preload" href={cdn.fonts.manrope} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={cdn.fonts.firaCode} as="font" type="font/woff2" crossorigin />

  {/* Resolve the theme before first paint to avoid a flash and flag that JS is
      live so reveal animations can hide-then-reveal. Without this class the
      content renders visible and in place (see global.css `html.js .reveal`).
      Shares the localStorage key + <html data-theme> contract with the
      Starlight docs (see components/shared/ThemeToggle.astro). */}
  <script is:inline>
    (() => {
      document.documentElement.classList.add('js');
      try {
        const pref = localStorage.getItem('starlight-theme');
        const dark =
          pref === 'dark' ||
          (pref !== 'light' &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    })();
  </script>
</head>
<body>
  {/* Bypass the repeated site navigation; every marketing page opens its
      <main> with id="top", also used by the footer's back-to-top link. */}
  <a class="skip-link" href="#top">{copy.nav.skip}</a>
  <LandingNav copy={copy} locale={locale} />
  <slot />
  <LandingFooter copy={copy} locale={locale} />
</body>
</html>
