# Cloudflare Workers Static Assets honors this file at the assets root.
# Astro emits content-hashed bundles under /_astro/, safe to cache forever.
# HTML keeps the default revalidating behavior.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/openapi.json
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/index.json
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/:skill/SKILL.md
  Access-Control-Allow-Origin: *

/.well-known/mcp/server-card.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Access-Control-Expose-Headers: ETag
  Cache-Control: public, max-age=3600

# Machine copies of pages (markdown twins, llms-full.txt, the MCP page index)
# stay out of search indexes, so they never compete with the HTML they
# duplicate. Agents still fetch them. The Worker sets the same header on the
# copies it serves itself (src/worker.ts).
/*.md
  X-Robots-Tag: noindex

/llms-full.txt
  X-Robots-Tag: noindex

/*/llms-full.txt
  X-Robots-Tag: noindex

/agentic/*
  X-Robots-Tag: noindex

/manual-routes.json
  X-Robots-Tag: noindex
