# THE pinned third-party sources every native build compiles from.
#
# This file is the single source of truth. It used to be two or three: each
# scripts/natives/build_*.sh carried a `${X_REF:-<sha>}` default AND
# .github/workflows/release.yml repeated them in an `env:` block (WAP_REF
# managed three copies). renovate.json's custom managers target THIS file for
# git SHAs plus SHERPA_ONNX_VERSION and APPIMAGETOOL_URL. LAME is an explicit
# freeze (last upstream release, 2017). Other regex managers cover Dart consts,
# vendored fonts, flutter_pty, .fvmrc and digest-pinned OCI images.
# test/tooling/native_pins_test.dart fails the build if a pinned ref reappears
# as an assignment anywhere else, or if a ref has no renovate.json manager.
#
# FORMAT — `KEY=value  # vX.Y.Z`. Two consumers constrain it:
#   * load_native_pins (scripts/lib/common.sh) sources it, stripping the inline
#     comment and never overrides a value already in the environment — so
#     `FFF_REF=<other> bash build_fff.sh` still works for a one-off bisect.
#   * Renovate matches git refs as `<KEY>…<40-hex digest>…<vX.Y.Z>` on ONE line,
#     which is why the version comment must stay on the assignment line rather
#     than above it. Version-only pins (SHERPA_ONNX_VERSION, APPIMAGETOOL_URL)
#     match the version string; their checksums are follow-up work on that PR.
#
# Bump a ref and its version comment together. The tree-sitter runtime and its
# grammars are grouped in renovate.json so the parser ABI stays consistent.

# rift — copy-on-write worktree engine. Not built on Windows: no MSVC CoW
# backend, so `git worktree` is the backend there.
RIFT_REPO=https://github.com/anomalyco/rift.git
RIFT_REF=18ca9d199cfa0033e1adf63b1eb6625fab89478a # v0.0.10

# fff — fast fuzzy file finder.
FFF_REPO=https://github.com/dmtrKovalenko/fff.git
FFF_REF=c6013ba6a5918221b6c482486aca01acc0830825 # v0.10.6

# tree-sitter runtime + shipped grammars. Renovate groups these so a runtime
# bump never lands without matching grammars (parser ABI).
TREE_SITTER_REPO=https://github.com/tree-sitter/tree-sitter.git
TREE_SITTER_REF=6070dbfefd326bd735e5683eb128cc1b57dad0c0 # v0.27.0
TS_DART_REF=a9bdfa3db2fbc9b9f12c93450d04a671f33a5102 # v0.0.1 (master)
TS_JAVASCRIPT_REF=44c892e0be055ac465d5eeddae6d3e194424e7de # v0.25.0
TS_TYPESCRIPT_REF=f975a621f4e7f532fe322e13c4f79495e0a7b2e7 # v0.23.2
TS_PHP_REF=5b5627faaa290d89eb3d01b9bf47c3bb9e797dea # v0.24.2
TS_PYTHON_REF=293fdc02038ee2bf0e2e206711b69c90ac0d413f # v0.25.0
TS_RUST_REF=77a3747266f4d621d0757825e6b11edcbf991ca5 # v0.24.2
TS_ZIG_REF=b670c8df85a1568f498aa5c8cae42f51a90473c0 # v1.1.2
TS_C_REF=b780e47fc780ddc8da13afa35a3f4ed5c157823d # v0.24.2
TS_CPP_REF=f41e1a044c8a84ea9fa8577fdd2eab92ec96de02 # v0.23.4
TS_GO_REF=1547678a9da59885853f5f5cc8a99cc203fa2e2c # v0.25.0
TS_JAVA_REF=94703d5a6bed02b98e438d7cad1136c01a60ba2c # v0.23.5
TS_RUBY_REF=71bd32fb7607035768799732addba884a37a6210 # v0.23.1
TS_C_SHARP_REF=cac6d5fb595f5811a076336682d5d595ac1c9e85 # v0.23.5
TS_SWIFT_REF=31d17fe7e818a2048c808b5c6fdc2dc792f4f5b5 # v0.7.3-with-generated-files
TS_KOTLIN_REF=77dd60ea0a9003ce062c9728a513ffe1aaff8c82 # v1.1.0
TS_R_REF=346d3707b8c9301f1051e8f6e32666e67529f7d2 # v1.3.0
TS_ASM_REF=5bb5b03e3c1ce5853b5282b9fba060f7c7bbf11e # v0.24.0
TS_MATLAB_REF=f03d0347acd8bb05d4edd8c845ac1718729e1fad # v1.3.1
TS_ADA_REF=dd5fa4cdb3aba91abc687aa68fb1431396fce6a6 # v0.1.0 (master)

# WebRTC audio processing (AEC3) — pulseaudio/webrtc-audio-processing.
WAP_REPO=https://gitlab.freedesktop.org/pulseaudio/webrtc-audio-processing.git
WAP_REF=d0569cfa50c1858ee279d77b3fc8870be6902441 # v2.1

# LAME — MP3 encoding for the soundscape recorder. A source tarball, so it is
# pinned by CHECKSUM rather than by commit.
#
# NOT Renovate-tracked: 3.100 (October 2017) is the last upstream release.
LAME_VERSION=3.100
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# sherpa-onnx — the speech + ONNX Runtime static libraries linked into
# libcc_inference (packages/cc_natives/native/inference/).
#
# Pinned by VERSION + per-platform CHECKSUM. The `sherpa-onnx-sys` build script
# would otherwise download this archive itself, unverified, at build time;
# scripts/natives/build_inference.sh pre-fetches it, checks it and hands the
# extracted lib dir over via SHERPA_ONNX_LIB_DIR.
#
# Bump the version and ALL checksums together and regenerate
# packages/cc_natives/native/inference/src/ort_sys.rs if the bundled ONNX
# Runtime version moves (see that file's header for the recipe). The archives
# are `<name>-static-lib.tar.bz2` assets on the k2-fsa/sherpa-onnx release.
# Renovate tracks SHERPA_ONNX_VERSION (grouped with sherpa-onnx-sys); checksums
# are follow-up work on that PR.
SHERPA_ONNX_VERSION=1.13.8
SHERPA_ONNX_LIB_SHA256_MACOS_ARM64=9091bf160dc7fdacedbc906b212badf53c2993f4e5277a0e03998e96c31d60da
SHERPA_ONNX_LIB_SHA256_MACOS_X64=a3f88da3e54c850a12d61431e73f8affcd1f13738b75b768847dd79541835b4b
SHERPA_ONNX_LIB_SHA256_LINUX_X64=e1fdc5b67530e15741ef897fa5ffff297056f3bf0c6d829a27af9225a4c4b5a6
SHERPA_ONNX_LIB_SHA256_LINUX_ARM64=77983e3cf29aa60f2e531d249dbd01d15596530550c8db2e9e02fc6a655da6bb
# Windows uses the STATIC-CRT (`-MT-`) archive, so the Rust build must also link
# the static CRT (`RUSTFLAGS=-Ctarget-feature=+crt-static`) — mixing it with
# Rust's default /MD is a duplicate-CRT link error. See windows_natives.sh.
SHERPA_ONNX_LIB_SHA256_WIN_X64=56ffcf3c454c1f14f7bc9887286cc8143e7e542dc632804e1c447d5f8d534eaf

# appimagetool — packages the Linux AppImage.
#
# Pinned to a TAGGED release, not the `continuous` tag it used to pull. The
# continuous asset is rebuilt in place, so it was both unverifiable and able to
# change under a release without any commit in this repo. Renovate tracks the
# version in the URL; APPIMAGETOOL_SHA256 is follow-up work on that PR.
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
