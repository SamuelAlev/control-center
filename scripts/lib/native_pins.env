# THE pinned third-party sources every native build compiles from.
#
# This file is the single source of truth. It used to be two or three: each
# scripts/natives/build_*.sh carried a `${X_REF:-<sha>}` default AND
# .github/workflows/release.yml repeated them in an `env:` block (WAP_REF
# managed three copies). renovate.json's custom managers target THIS file for
# git SHAs plus SHERPA_ONNX_VERSION and APPIMAGETOOL_URL. LAME is an explicit
# freeze (last upstream release, 2017). Other regex managers cover Dart consts,
# vendored fonts, flutter_pty, .fvmrc and digest-pinned OCI images.
# test/tooling/native_pins_test.dart fails the build if a pinned ref reappears
# as an assignment anywhere else, or if a ref has no renovate.json manager.
#
# FORMAT — `KEY=value  # vX.Y.Z`. Two consumers constrain it:
#   * load_native_pins (scripts/lib/common.sh) sources it, stripping the inline
#     comment and never overrides a value already in the environment — so
#     `FFF_REF=<other> bash build_fff.sh` still works for a one-off bisect.
#   * Renovate matches git refs as `<KEY>…<40-hex digest>…<vX.Y.Z>` on ONE line,
#     which is why the version comment must stay on the assignment line rather
#     than above it. Version-only pins (SHERPA_ONNX_VERSION, RHTTP_VERSION,
#     APPIMAGETOOL_URL) match the version string; their checksums are follow-up
#     work on that PR.
#
# Bump a ref and its version comment together. The tree-sitter runtime and its
# grammars are grouped in renovate.json so the parser ABI stays consistent.

# rift — copy-on-write worktree engine. Not built on Windows: no MSVC CoW
# backend, so `git worktree` is the backend there.
RIFT_REPO=https://github.com/anomalyco/rift.git
RIFT_REF=35ada0360e61fdadbba94bd0f10bc9b3365c0ae9 # v0.0.13

# fff — fast fuzzy file finder.
FFF_REPO=https://github.com/dmtrKovalenko/fff.git
FFF_REF=95fd777c2529fc7b4d7572dabff64cc07268f2c5 # v0.11.0

# tree-sitter runtime + shipped grammars. Renovate groups these so a runtime
# bump never lands without matching grammars (parser ABI).
TREE_SITTER_REPO=https://github.com/tree-sitter/tree-sitter.git
TREE_SITTER_REF=10eb5ac119eec9cb4267a8e035066473983f5f3a # v0.27.1
TS_DART_REF=be07cf7118d3dba06236a3f19541685a68209934 # v0.0.1 (master)
TS_JAVASCRIPT_REF=44c892e0be055ac465d5eeddae6d3e194424e7de # v0.25.0
TS_TYPESCRIPT_REF=f975a621f4e7f532fe322e13c4f79495e0a7b2e7 # v0.23.2
TS_PHP_REF=58d5643086ae60e93a3746cca648363ee97c8761 # v0.25.1
TS_PYTHON_REF=293fdc02038ee2bf0e2e206711b69c90ac0d413f # v0.25.0
TS_RUST_REF=77a3747266f4d621d0757825e6b11edcbf991ca5 # v0.24.2
TS_ZIG_REF=b670c8df85a1568f498aa5c8cae42f51a90473c0 # v1.1.2
TS_C_REF=b780e47fc780ddc8da13afa35a3f4ed5c157823d # v0.24.2
TS_CPP_REF=f41e1a044c8a84ea9fa8577fdd2eab92ec96de02 # v0.23.4
TS_GO_REF=1547678a9da59885853f5f5cc8a99cc203fa2e2c # v0.25.0
TS_JAVA_REF=94703d5a6bed02b98e438d7cad1136c01a60ba2c # v0.23.5
TS_RUBY_REF=71bd32fb7607035768799732addba884a37a6210 # v0.23.1
TS_C_SHARP_REF=cac6d5fb595f5811a076336682d5d595ac1c9e85 # v0.23.5
TS_SWIFT_REF=82bb3a533e0801fd2bbaa11dc49676e10bf41948 # v0.7.4-with-generated-files
TS_KOTLIN_REF=77dd60ea0a9003ce062c9728a513ffe1aaff8c82 # v1.1.0
TS_R_REF=346d3707b8c9301f1051e8f6e32666e67529f7d2 # v1.3.0
TS_ASM_REF=5bb5b03e3c1ce5853b5282b9fba060f7c7bbf11e # v0.24.0
TS_MATLAB_REF=f03d0347acd8bb05d4edd8c845ac1718729e1fad # v1.3.1
TS_ADA_REF=dd5fa4cdb3aba91abc687aa68fb1431396fce6a6 # v0.1.0 (master)

# WebRTC audio processing (AEC3) — pulseaudio/webrtc-audio-processing.
WAP_REPO=https://gitlab.freedesktop.org/pulseaudio/webrtc-audio-processing.git
WAP_REF=d0569cfa50c1858ee279d77b3fc8870be6902441 # v2.1

# sqlite-vector — the vector-search SQLite extension behind pub's
# `sqlite_vector`. That package bundles a prebuilt for every target except
# Windows ARM64, so windows_natives.sh compiles that one from this pin. Upstream
# tags carry no `v`; the comment keeps one for the pin format. It must name the
# same release as pubspec.lock's sqlite_vector (native_pins_test.dart).
SQLITE_VECTOR_REPO=https://github.com/sqliteai/sqlite-vector.git
SQLITE_VECTOR_REF=0c2223ada9dce1fa33248c8835a15f51d9a0f655 # v1.1.2

# LAME — MP3 encoding for the soundscape recorder. A source tarball, so it is
# pinned by CHECKSUM rather than by commit.
#
# NOT Renovate-tracked: 3.100 (October 2017) is the last upstream release.
LAME_VERSION=3.100
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# rhttp — the Rust HTTP engine (reqwest + rustls) behind every server HTTP
# client. Consumed as a PURE-DART pub package: patches/rhttp@0.18.0.patch drops
# its Flutter plugin registration, and scripts/natives/build_rhttp.sh builds
# this crate so `librhttp` ships with the other natives.
#
# Pinned to pub.dev's PUBLISHED ARCHIVE rather than a git checkout: that
# artifact is what pub itself verifies, it is the revision the Dart bindings
# were generated from, and it carries the `rust/Cargo.lock` that `--locked`
# needs. Pinned by version + CHECKSUM, like LAME and sherpa-onnx.
#
# Bump RHTTP_VERSION together with the rhttp pin in pubspec.lock AND
# patches/rhttp@<version>.patch — patchwork applies only to the exact version,
# and a Dart-side binding newer than the compiled wire code fails on the first
# request. test/tooling/native_pins_test.dart checks all three against each
# other.
RHTTP_VERSION=0.18.0
RHTTP_URL=https://pub.dev/api/archives/rhttp-0.18.0.tar.gz
RHTTP_SHA256=954d5a9aa5a4f1e2a8612e8cb9ecbe4fc0826fcbf0406f40115573e2e92b7dde

# sherpa-onnx — the speech + ONNX Runtime static libraries linked into
# libcc_inference (packages/cc_natives/native/inference/).
#
# Pinned by VERSION + per-platform CHECKSUM. The `sherpa-onnx-sys` build script
# would otherwise download this archive itself, unverified, at build time;
# scripts/natives/build_inference.sh pre-fetches it, checks it and hands the
# extracted lib dir over via SHERPA_ONNX_LIB_DIR.
#
# Bump the version and ALL checksums together and regenerate
# packages/cc_natives/native/inference/src/ort_sys.rs if the bundled ONNX
# Runtime version moves (see that file's header for the recipe). The archives
# are `<name>-static-lib.tar.bz2` assets on the k2-fsa/sherpa-onnx release.
# Renovate tracks SHERPA_ONNX_VERSION (grouped with sherpa-onnx-sys); checksums
# are follow-up work on that PR.
SHERPA_ONNX_VERSION=1.13.8
SHERPA_ONNX_LIB_SHA256_MACOS_ARM64=9091bf160dc7fdacedbc906b212badf53c2993f4e5277a0e03998e96c31d60da
SHERPA_ONNX_LIB_SHA256_MACOS_X64=a3f88da3e54c850a12d61431e73f8affcd1f13738b75b768847dd79541835b4b
SHERPA_ONNX_LIB_SHA256_LINUX_X64=e1fdc5b67530e15741ef897fa5ffff297056f3bf0c6d829a27af9225a4c4b5a6
SHERPA_ONNX_LIB_SHA256_LINUX_ARM64=77983e3cf29aa60f2e531d249dbd01d15596530550c8db2e9e02fc6a655da6bb
# Windows uses the STATIC-CRT (`-MT-`) archive, so the Rust build must also link
# the static CRT (`RUSTFLAGS=-Ctarget-feature=+crt-static`) — mixing it with
# Rust's default /MD is a duplicate-CRT link error. See windows_natives.sh.
SHERPA_ONNX_LIB_SHA256_WIN_X64=56ffcf3c454c1f14f7bc9887286cc8143e7e542dc632804e1c447d5f8d534eaf
SHERPA_ONNX_LIB_SHA256_WIN_ARM64=609988769f805ca2a602622174ac737edf6dce8a50efa2da9da2d915947da31b

# appimagetool — packages the Linux AppImage.
#
# Pinned to a TAGGED release, not the `continuous` tag it used to pull. The
# continuous asset is rebuilt in place, so it was both unverifiable and able to
# change under a release without any commit in this repo. Renovate tracks the
# version in the URL; APPIMAGETOOL_SHA256 is follow-up work on that PR.
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0

# AppImage type2-runtime — the static ELF stub at the front of every AppImage.
# appimagetool downloads it from type2-runtime's `continuous` release unless it
# is handed one, so linux_package.sh fetches this tagged build and passes it
# with --runtime-file. Renovate tracks the tag; bump the checksum with it (and
# the version in scripts/lib/third_party.sh).
APPIMAGE_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d

# sentry-cli — uploads debug files and web source maps
# (scripts/release/sentry_upload.sh). It replaced the sentry_dart_plugin dev
# dependency, whose transitive chain carried the discontinued `globbing`
# package; that plugin also downloaded its own unpinned sentry-cli at run time.
#
# Pinned by VERSION plus a per-target CHECKSUM: the script builds the GitHub
# release URL from SENTRY_CLI_VERSION, verifies the bytes with sha256_of, and
# then checks the binary reports that version, so neither a swapped asset nor a
# half-applied bump can go unnoticed. Renovate tracks SENTRY_CLI_VERSION; a
# version bump must carry fresh checksums in the same commit (the download fails
# loudly until it does) — the same rule the sherpa-onnx checksums follow.
#
# 3.8.0 is the release whose subcommands this repository's arguments were
# verified against (debug-files upload, sourcemaps inject/upload, releases
# new|set-commits|finalize).
SENTRY_CLI_VERSION=3.8.0
SENTRY_CLI_SHA256_DARWIN_UNIVERSAL=2c26914636c47ab9bf9e710484ad7b44d371cbec8bd29cafb36b3cf877bf4285
SENTRY_CLI_SHA256_LINUX_X86_64=13f8cb34ae01a6a272d7d7c22e277a105286615b4020de900ea95a8de47cdbb6
SENTRY_CLI_SHA256_LINUX_AARCH64=eaea24b5b47b61a96d9a2e353268ea41fd9a8c5b7979694330df614d4af672bf
SENTRY_CLI_SHA256_WINDOWS_X86_64=2257cf6805a616f5c3ee291a549ebbba021190048b646adc006beb4e8cdef7fd
SENTRY_CLI_SHA256_WINDOWS_AARCH64=174786337bf2d3cd3386c14aab122ba3d3bbd49b98e124666b03f63f54e4104f

# FFmpeg is a separate GPLv3 executable, never linked into the app. macOS
# uses Martin Riedl's dated 9.0.2 release; the other targets use BtbN's
# retained monthly build from the 9.0 branch (n9.0.2 + 17 commits). The
# per-archive digests are published by the respective release publishers.
# Do not replace the dated/tagged assets with their mutable "latest" aliases.
# The *_COMMIT values below are provenance links printed into the license
# notice (publisher recipe and source revisions), never fetched or compiled.
# They are deliberately not `*_REF` pins: they have no upstream tags for
# Renovate to track and move only with the publisher builds above.
FFMPEG_MEDIA_VERSION=9.0.2
FFMPEG_MEDIA_MAC_BUILD=1789931890_9.0.2
# Historical publisher recipe revision preceding this dated build; its
# version/ pins match the published FFmpeg and libwebp versions.
FFMPEG_MEDIA_MAC_RECIPE_COMMIT=6a611e19870e197bc37c6e4c7fccddebd3715466
FFMPEG_MEDIA_BTBN_RELEASE=autobuild-2026-09-30-13-08
FFMPEG_MEDIA_BTBN_RECIPE_COMMIT=6c9aec5fc9a72ec3abedd1fa84db141fa18cf52b
FFMPEG_MEDIA_BTBN_BUILD=n9.0.2-17-g2a571b6068
FFMPEG_MEDIA_BTBN_SOURCE_COMMIT=2a571b606854520cf89804d8030c8b328e621689
FFMPEG_MEDIA_SHA256_MAC_FFMPEG=c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924
FFMPEG_MEDIA_SHA256_MAC_FFPROBE=fcbe839537485eaee7a7a8bc5cbc0f90d53617e80943e8a5b2e31cb851197ea6
FFMPEG_MEDIA_SHA256_LINUX_X64=68ee646831adaae2495618346f3bba94ff207ff83bbd34d643e7004730d66269
FFMPEG_MEDIA_SHA256_WIN_X64=a0e45723c72141975f51d8666302e614711745f3102b704ca3f82c897a58d278
FFMPEG_MEDIA_SHA256_WIN_ARM64=6dcd0626f9f6d6c7323565e57410e9f37ed14a85946ec9ea9caff294ca32f5c0

# Upstream source archive is used for the exact-version LICENSE/COPYING notices,
# never compiled.
FFMPEG_MEDIA_SOURCE_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
# Riedl versions.txt: zlib 1.3.2. BtbN scripts.d/20-zlib.sh at release tag
# pins madler/zlib@767c4c947852e143f582c85f14cf573411df1b35; that
# commit's zlib.h reports 1.3.2.1-motley, not 1.3.2. These versions describe
# the selected FFmpeg prebuilts and source provenance, not independent
# dependencies. Refresh them only when updating the FFmpeg publisher builds.
ZLIB_MEDIA_VERSION=1.3.2
ZLIB_MEDIA_BTBN_VERSION=1.3.2.1-motley

# PDFium binary distribution (scripting/V8 disabled), immutable upstream
# chromium/8100 release (PDFium 157.0.8100.0). GitHub asset SHA-256 digests
# recorded in its API.
PDFIUM_MEDIA_VERSION=8100
PDFIUM_MEDIA_SHA256_MAC_ARM64=7ea647c7a7a9c1169be3f947000bc071ece2fade2cd6bd7e401e3675c6560cce
PDFIUM_MEDIA_SHA256_LINUX_X64=1c1894a12d4d96ee01400c3874444126254180c5c7d2ab628576b67f8120320a
PDFIUM_MEDIA_SHA256_WIN_X64=51621bcc1d9be9ea448f4b84b0516862b928e3968d3fca899af1a6d6e2848d6d
