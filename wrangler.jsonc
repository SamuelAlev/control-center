{
  // Cloudflare Pages deploy config for the Control Center WEB CLIENT.
  //
  // `scripts/build_web.sh` emits a Wasm SPA into ./build/web: SkWasm for modern
  // browsers plus the generated CanvasKit fallback. The SPA fallback serves
  // index.html for every unknown path so client-side routing / deep links (the
  // pairing fragment) resolve to the app shell.
  //
  // The web client is a thin client: it probes and connects to a user-selected
  // cc-server, then exposes decrypted resources through same-origin Service
  // Worker capabilities. worker/csp.js stamps a cookie-independent CSP;
  // connecting or switching servers never requires a document reload.
  "name": "control-center-webapp",
  "compatibility_date": "2026-06-08",
  "main": "worker/csp.js",
  "assets": {
    "directory": "./build/web",
    // Exposes env.ASSETS so the Worker can serve the static bundle itself.
    "binding": "ASSETS",
    // Run the Worker before assets so every response receives the security
    // headers (including index.html, otherwise served directly).
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
