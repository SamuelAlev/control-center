{
  "permissions": {
    "allow": [
      "Bash(dart analyze *)",
      "Bash(flutter test *)",
      "Bash(fvm flutter *)",
      "Bash(fvm dart analyze *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-test-concurrency.py\"",
            "statusMessage": "Checking test concurrency cap"
          }
        ]
      }
    ]
  }
}
