index ae2c1fcf4ca758f940445eb68d10017b20b314e0..3bda969ab022c88206191d215922c969e4a78e0d 100644
--- a/windows/CMakeLists.txt
+++ b/windows/CMakeLists.txt
@@ -18,8 +18,19 @@ set(PLUGIN_NAME "auto_updater_windows_plugin")
 
 # WinSparkle
 set(WIN_SPARKLE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/WinSparkle-0.8.1")
-set(WIN_SPARKLE_BINARIES "${WIN_SPARKLE_DIR}/x64/Release/WinSparkle.dll")
-set(WIN_SPARKLE_LIBRARIES "${WIN_SPARKLE_DIR}/x64/Release/WinSparkle.lib")
+# Control Center patch: link and bundle the WinSparkle build for the target
+# architecture. The prebuilt ships x64 and ARM64; hard-coding x64 broke native
+# Windows on Arm builds (an ARM64 runner cannot load an x64 DLL).
+# FLUTTER_TARGET_PLATFORM is what `flutter build windows` passes to CMake
+# (windows-x64 / windows-arm64); the app's windows/flutter/CMakeLists.txt
+# defaults it to windows-x64.
+if(FLUTTER_TARGET_PLATFORM STREQUAL "windows-arm64")
+  set(WIN_SPARKLE_ARCH "ARM64")
+else()
+  set(WIN_SPARKLE_ARCH "x64")
+endif()
+set(WIN_SPARKLE_BINARIES "${WIN_SPARKLE_DIR}/${WIN_SPARKLE_ARCH}/Release/WinSparkle.dll")
+set(WIN_SPARKLE_LIBRARIES "${WIN_SPARKLE_DIR}/${WIN_SPARKLE_ARCH}/Release/WinSparkle.lib")
 
 # Any new source files that you add to the plugin should be added here.
 list(APPEND PLUGIN_SOURCES
