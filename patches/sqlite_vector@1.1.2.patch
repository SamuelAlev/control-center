+/// Control Center patch: the Windows ARM64 DLL staged in the natives directory
+/// the cc_server hook also reads (the repo-root `.cc_natives_prebuilt_dir`
+/// pointer, else `build/natives`), under `sqlite_vector/` so that hook's
+/// top-level `*.dll` sweep never bundles a second copy.
+File _controlCenterWindowsArm64Binary(BuildInput input) {
+  // patchwork applies this copy under <repo>/.dart_tool/patchwork/; walk up to
+  // the checkout rather than hard-coding the depth.
+  var repo = Directory.fromUri(input.packageRoot).absolute;
+  while (!File(
+    p.join(repo.path, 'scripts', 'lib', 'native_pins.env'),
+  ).existsSync()) {
+    final parent = repo.parent;
+    if (parent.path == repo.path) {
+      throw StateError(
+        'sqlite_vector (Control Center patch): no Control Center checkout '
+        'above ${input.packageRoot.toFilePath()}.',
+      );
+    }
+    repo = parent;
+  }
+  var staging = p.join(repo.path, 'build', 'natives');
+  final pointer = File(p.join(repo.path, '.cc_natives_prebuilt_dir'));
+  if (pointer.existsSync()) {
+    final target = pointer.readAsStringSync().trim();
+    if (target.isNotEmpty) {
+      staging = target;
+    }
+  }
+  final file = File(
+    p.join(staging, 'sqlite_vector', 'vector_windows_arm64.dll'),
+  );
+  if (!file.existsSync()) {
+    throw StateError(
+      'sqlite_vector: ${file.path} is missing. Windows ARM64 has no prebuilt '
+      'extension; run scripts/release/windows_natives.sh arm64 first.',
+    );
+  }
+  return file;
+}
